{
  "name": "@kaveraa/site-audit",
  "version": "0.1.0",
  "description": "Audit a website you own from the command line: SEO, security headers, TLS and known vulnerabilities, with a fix for every finding.",
  "keywords": [
    "seo",
    "security",
    "audit",
    "headers",
    "tls",
    "csp",
    "hsts",
    "vulnerabilities",
    "osv",
    "cli"
  ],
  "homepage": "https://github.com/kaveraa/site-audit#readme",
  "bugs": {
    "url": "https://github.com/kaveraa/site-audit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaveraa/site-audit.git"
  },
  "license": "MIT",
  "author": "Augustin Kavera (https://github.com/kaveraa)",
  "type": "module",
  "bin": {
    "site-audit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.fr.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
